# ============ AI Data Science Team - Configuration ============
# Copy this file to `.env` and fill in the values you need.

# --- LLM provider -----------------------------------------------------------
# Supported: openai | anthropic | ollama
# If blank / no key is configured, the pipeline falls back to a local
# rule-based "mock" LLM so the full workflow still runs without a key.
LLM_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Application ------------------------------------------------------------
# Directory where uploaded datasets are stored.
UPLOAD_DIR=uploads
MODEL_DIR=models
REPORT_DIR=reports
DEPLOY_DIR=deployments
SQLITE_DB=ai_ds_team.db

# --- Security -----------------------------------------------------------------
# Explicit CORS allowlist (comma-separated). Never use "*".
# Defaults cover the Vite dev server, React dashboard, Streamlit and same-host API.
# BACKEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501
#
# When set (non-empty), every mutating endpoint (POST /upload, /workflow, /chat,
# /sql, /memory/search, /deploy, /predict, /export/github) requires header
# `X-API-Key: <value>`; requests without it get 401. Leave empty to disable.
# API_KEY=change-me-in-production
#
# Sandbox hard timeout in seconds for the /python tool child process.
# PYTHON_TOOL_TIMEOUT=90

# --- Feature engineering ----------------------------------------------------
# Rank and keep only the strongest features before training.
# Set to a positive number (e.g. 20) to enable; 0 keeps all features.
FEATURE_SELECTION=true
MAX_FEATURES=0

# --- Experiment tracking (optional) ------------------------------------------
# Leave empty to use the built-in SQLite tracker only.
# Install `mlflow` and point to a server or a local file path, e.g.:
#   MLFLOW_TRACKING_URI=./mlruns
MLFLOW_TRACKING_URI=

# --- GitHub report export (optional) -----------------------------------------
# Set both values to enable `POST /export/github/{run_id}`.
GITHUB_TOKEN=
GITHUB_REPO=
