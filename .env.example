# ============ AI Data Science Team - Configuration ============
# Copy this file to `.env` and fill in the values you need.

# --- LLM provider -----------------------------------------------------------
# Supported: openai | anthropic | ollama
# If blank / no key is configured, the pipeline falls back to a local
# rule-based "mock" LLM so the full workflow still runs without a key.
LLM_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Application ------------------------------------------------------------
# Directory where uploaded datasets are stored.
UPLOAD_DIR=uploads
MODEL_DIR=models
REPORT_DIR=reports
SQLITE_DB=ai_ds_team.db
